{
  "name": "family-finance-buddy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Family Finance Buddy — a household finance app for an Indian family. Static SPA on GitHub Pages, talking directly to Supabase.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:policies": "supabase test db",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:design": "node scripts/check-design-tokens.mjs && node scripts/check-design-sync.mjs",
    "check:sql": "node scripts/check-sql-uuids.mjs",
    "db:reset": "supabase db reset",
    "db:seed:local": "psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -v ON_ERROR_STOP=1 -f supabase/seed/demo_household.sql",
    "check:actions": "bash scripts/check-actions-pinned.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "supabase": "^2.116.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
