# Family Finance Buddy — local environment
#
# Both values below are PUBLIC by design. They are compiled into the bundle
# that ships to GitHub Pages, so treat them as configuration, not secrets:
# in GitHub Actions they go in repository VARIABLES, never secrets.
#
#   URL              Settings -> Data API  (base URL only, no /rest/v1)
#   Publishable key  Settings -> API Keys  (sb_publishable_...)

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# NEVER put an sb_secret_... key in this file, any committed file, the bundle,
# or a build log. It bypasses every row-level security policy. If one is ever
# exposed, rotate it in the dashboard immediately.
