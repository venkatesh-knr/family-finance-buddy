# End-to-end test account — copy to .env.e2e and fill in.
#
# .env.e2e is gitignored. Keep it that way: these are real credentials for a
# real login, even though the household behind it is a demo one.
#
# The account MUST belong to a household marked demo. The setup step checks for
# the DEMO badge and fails the run if it is missing — these specs write
# expenses, and deletes are soft everywhere in this app.
#
# This file holds no Supabase keys. It never should: the publishable key already
# ships in the bundle and is read from .env, and the secret key must never
# appear in the repo at all.

E2E_EMAIL=demo@example.com
E2E_PASSWORD=

# Base32 secret from the authenticator enrolment for the account above. Shown
# under "Or enter this by hand" during TOTP setup, and not recoverable later
# without re-enrolling.
E2E_TOTP_SECRET=

# Defaults to http://localhost:5173. Set it to the Pages URL to run the suite
# against a deployed build.
# E2E_BASE_URL=
